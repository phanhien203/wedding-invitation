# ── Admin ───────────────────────────────────────────────────────────
# Mật khẩu đăng nhập trang admin
ADMIN_PASSWORD=changeme

# Chuỗi bí mật để ký cookie phiên đăng nhập admin (đặt chuỗi ngẫu nhiên dài)
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ── MongoDB (lưu dữ liệu: config, khách mời, RSVP, lời chúc) ─────────
# Connection string từ MongoDB Atlas. Trên Vercel: thêm biến này ở
# Settings → Environment Variables, và Atlas → Network Access cho phép 0.0.0.0/0
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
# Tên database dùng trong cluster
MONGODB_DB=wedding

# ── Khác ────────────────────────────────────────────────────────────
# Google Maps JavaScript API key (hiện bản đồ dùng iframe embed nên có thể bỏ trống)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Giới hạn dung lượng upload ảnh (MB)
NEXT_PUBLIC_MAX_UPLOAD_MB=5

# ── Cloudinary (nơi lưu ảnh upload) ─────────────────────────────────
# Dashboard > Product Environment Credentials > API environment variable
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Thư mục chứa ảnh trên Cloudinary (mặc định: wedding)
CLOUDINARY_FOLDER=wedding
